{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "BastionInfraReadOnly",
            "Effect": "Allow",
            "Action": [
                "acm:Describe*",
                "acm:Get*",
                "acm:List*",
                "autoscaling:Describe*",
                "autoscaling:Get*",
